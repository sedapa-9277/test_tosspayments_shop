# 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요. (.env 는 git 에 올라가지 않습니다)
# 브라우저(정적 사이트)는 이 파일을 읽지 못합니다. 프론트용 공개 키는 js/config.js 에 있습니다.
#
# Supabase에 한 번에 등록하려면 (Supabase CLI 설치 후):
#   supabase secrets set --env-file .env --project-ref slgiczbxvmgvtookcplp

# 챗봇(chat 함수)이 쓰는 OpenAI API 키: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# 챗봇 지식 검색(임베딩)에 쓰는 Upstage API 키: https://console.upstage.ai (없으면 전체 목록을 프롬프트에 넣는 방식으로 동작)
UPSTAGE_API_KEY=up_...

# 선택: 챗봇 모델 (비워 두면 gpt-4o-mini)
CHAT_MODEL=

# 선택: 토스 시크릿 키 (비워 두면 토스 공개 테스트 키 사용). 실결제 시 live_gsk_... 로 교체
TOSS_SECRET_KEY=test_gsk_...
